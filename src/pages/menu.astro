---
import MenuCard from '../components/MenuCard.astro';
import MenuCardToggle from '../components/MenuCardToggle.astro';
import Modal from '../components/Modal.astro';
import { menuItems } from '../data/menuData';
import '../styles/global.css';
import '../styles/animations.css';
import '../styles/menuCards.css';
import '../styles/menuComponents.css';
import '../styles/menuToggle.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
		<link rel="shortcut icon" href="/assets/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Menú - Cafe Plaza</title>
		<meta name="description" content="Explora nuestro delicioso menú con platillos tradicionales ecuatorianos y más" />
	</head>
	<body>
		<!-- Menu Section - Responsive -->
		<section class="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-yellow-50 pb-4 px-2 flex flex-col cafe-texture">
			<div class="max-w-4xl md:max-w-6xl lg:max-w-7xl mx-auto w-full flex-1 flex flex-col px-2 md:px-4">
				<!-- Header minimalista -->
				<div class="text-center mb-3 mt-3">
					<img src="/assets/logo.png" alt="Café Plaza" class="h-14 w-14 mx-auto mb-1 object-contain">
					<p class="text-xs text-amber-800 font-serif italic">Que nunca falte la fé, el amor, ni el Café</p>
				</div>

				<!-- Grid responsivo -->
				<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-2 md:gap-4 flex-1" id="menu-grid">
					{menuItems.map((item) => (
						item.hasToggle && item.toggleOptions ? (
							<MenuCardToggle 
								name={item.name}
								image={item.image}
								toggleOptions={item.toggleOptions}
							/>
						) : (
							<MenuCard 
								name={item.name}
								price={item.price}
								image={item.image}
								ingredients={item.ingredients}
							/>
						)
					))}
				</div>
			</div>
		</section>

		<!-- Modal Component -->
		<Modal />

		<!-- Footer -->
		<footer class="bg-amber-900 py-2">
			<div class="text-center">
				<p class="text-amber-200 text-xs font-serif italic">Que nunca falte la fé, el amor, ni el Café</p>
			</div>
		</footer>

		<script>
			import { initializeAll } from '../scripts/menuInteractions';

			document.addEventListener('DOMContentLoaded', () => {
				initializeAll();
			});
		</script>
	</body>
</html>
